# Production must use a cryptographically random secret of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set only for the first database initialization; choose a unique strong password.
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

# Exact frontend origins, comma-separated. Never use * in production.
CORS_ORIGIN=https://eosis.example.sch.id

NODE_ENV=production
PORT=5000
# Optional; required only for AI assistant/transcription features.
GEMINI_API_KEY=

# Secret for irreversible HMAC pseudonyms used to enforce one-person-one-vote.
# Keep separate from AUTH_TOKEN_SECRET and never rotate during an active election.
VOTER_ID_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Set true only for one-time migration after backing up and reviewing data/db.json.
ALLOW_LEGACY_JSON_IMPORT=false

# Encrypt MFA TOTP secrets at rest in SQLite. Use a separate random secret.
ADMIN_MFA_ENCRYPTION_KEY=REPLACE_WITH_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
